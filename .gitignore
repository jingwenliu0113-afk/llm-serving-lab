# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large / machine-local artifacts (never commit weights, vendored builds or data)
models/
third_party/
*.gguf
*.safetensors

# Quality data and KLD logits (decision 005): private local archive only.
# Never commit dataset files or item text; commit only index lists + sha256.
data/
*.kld

# Scratch
.DS_Store

# Benchmark raw outputs stay in the local archive (docs/STORAGE_PLAN.md); each session
# commits plan / session / rows / env and raw_manifest.json (sha256 of every raw file).
results/**/raw/
# JIT caches of the Stage B cold / warm boots (benchmarks/coreb_stage_b.py; hundreds of MB, regenerable)
results/**/cache/

# Never commit environments, caches, deploy bundles or credentials
.env
*.pem
*.key
.cache/
*.tar

# Pinned git worktrees for formal Mac sessions (scratchpad batch_formal_a.sh); results are copied back
.worktrees/

# 027: product (service) test / load-test outputs; never research data, never committed
runs/
